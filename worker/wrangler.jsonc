{
  // Thumbs-up counter for the blog. Deploy by hand: see README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-likes",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "vars": {
    // Sites allowed to call the API (comma-separated). Local preview is included for testing.
    "ALLOWED_ORIGINS": "https://mvp-harry.github.io,http://127.0.0.1:4000,http://localhost:4000",
    // Max likes one IP can add to one post per day.
    "DAILY_LIMIT": "10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-likes",
      // Filled in from `npx wrangler d1 create blog-likes`.
      "database_id": "c374647e-3282-4cdb-b9b1-c315f01ec42a",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (not in this file): IP_SALT, set with `npx wrangler secret put IP_SALT`.
}
